# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cicddb
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# Server & Frontend URLs
SERVER_PORT=8080
APP_FRONTEND_URL=http://localhost:5173

# GitHub App Credentials
GITHUB_APP_ID=4525940
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_PRIVATE_KEY_PATH=classpath:github-private-key.pem
GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/github/callback
GITHUB_OAUTH_SCOPE=repo,user:email
GITHUB_API_BASE_URL=https://api.github.com
