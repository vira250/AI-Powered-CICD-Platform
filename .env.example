# ============================================================
# AI-Powered CI/CD Platform - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ---------- GitHub App Credentials ----------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Private Key configuration: path to PEM file generated by GitHub App
GITHUB_PRIVATE_KEY_PATH=./github-app-private-key.pem

# ---------- App Settings ----------
FRONTEND_URL=http://localhost:5173
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/callback

# ---------- PostgreSQL Settings ----------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_LOGIN_DB=login_db
PG_REPO_DB=repo_db

# ---------- Ngrok (set to false to disable) ----------
NGROK_ENABLED=false
NGROK_AUTHTOKEN=

# ---------- AI Agents Service (FastAPI) ----------
AGENTS_URL=http://localhost:8000
AGENTS_PORT=8000

# ---------- LLM (Gemini via Google AI) ----------
OPENROUTER_API_KEY=
LLM_MODEL=gemini-3.7-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------- Deployment Agent ----------
DOCKER_REGISTRY=docker.io
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_TOKEN=
PRODUCTION_HOST=
