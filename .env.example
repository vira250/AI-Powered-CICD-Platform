# Backend configuration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=classpath:github-private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=repo,workflow,user:email
AGENTS_URL=http://localhost:8001

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cicddb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Python agent (agents/.env or process environment)
GOOGLE_API_KEY=
LLM_PROVIDER=google